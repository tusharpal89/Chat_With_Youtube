# ---------------- LLM (the AI brain) ----------------
# Provider: groq (fast + free) | gemini (free) | openai | ollama
LLM_PROVIDER=groq
# Groq (recommended - fast + free): get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq chat models: openai/gpt-oss-120b (best) | openai/gpt-oss-20b (faster) | qwen/qwen3.8-27b
LLM_MODEL=openai/gpt-oss-120b
# Gemini (free): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (normally leave these blank)
# OPENAI_API_KEY=
# LLM_BASE_URL=

# ---------------- Transcription ----------------
# Preferred caption languages (comma separated), tried in order
TRANSCRIPT_LANGUAGES=en,hi
# When a video has NO captions:
#   - if GROQ_API_KEY is set  -> FAST transcription via Groq's Whisper API
#   - otherwise               -> local faster-whisper (slower, uses your CPU)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ENABLE_WHISPER_FALLBACK=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------------- RAG settings ----------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_CONTEXT_CHARS=20000
DEFAULT_TOP_K=5

# ---------------- Frontend ----------------
# (frontend reads this from frontend/.env as VITE_API_URL)
BACKEND_URL=http://localhost:8000
